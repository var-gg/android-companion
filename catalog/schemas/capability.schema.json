{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://var.gg/schemas/android-capability-registry/capability.schema.json",
  "title": "Android Capability Registry Capability Record",
  "type": "object",
  "required": ["catalog_version", "app_id", "capability"],
  "properties": {
    "catalog_version": { "type": "string", "const": "0.1" },
    "app_id": { "type": "string" },
    "capability": {
      "type": "object",
      "required": ["local_slug", "semantic", "title", "status", "surfaces"],
      "properties": {
        "local_slug": { "type": "string" },
        "semantic": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "normalized_key": { "type": ["string", "null"] },
            "status": {
              "type": "string",
              "enum": ["confirmed", "hypothesized", "unknown"]
            },
            "hypotheses": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "title": { "type": "string" },
        "summary": { "type": ["string", "null"] },
        "preconditions": { "type": "object", "additionalProperties": true },
        "expected_outcome": { "type": "object", "additionalProperties": true },
        "risk": {
          "type": "object",
          "properties": {
            "side_effect_class": {
              "type": "string",
              "enum": ["read_only", "navigation_only", "stateful", "transactional", "destructive"]
            },
            "user_confirmation_expected": { "type": "boolean" },
            "agent_safe_to_attempt": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "status": {
          "type": "object",
          "required": ["evidence", "runtime", "freshness"],
          "properties": {
            "evidence": {
              "type": "string",
              "enum": ["official_doc", "public_reference", "community_report", "device_observed", "mixed", "none"]
            },
            "runtime": {
              "type": "string",
              "enum": ["untested", "resolves_only", "verified", "partial", "blocked", "broken"]
            },
            "freshness": {
              "type": "string",
              "enum": ["fresh", "review_due", "stale_candidate", "stale_confirmed"]
            }
          },
          "additionalProperties": true
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["custom_scheme", "app_link", "web_link", "generic_intent", "intent_uri", "unknown"]
              },
              "uri_template": { "type": ["string", "null"] },
              "intent": { "type": "object", "additionalProperties": true },
              "routing": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": true
          }
        },
        "verification": {
          "type": "object",
          "properties": {
            "last_verified_at": { "type": ["string", "null"] },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "app_version_name": { "type": ["string", "null"] },
                  "app_version_code": { "type": ["number", "null"] },
                  "android_api_level": { "type": ["number", "null"] },
                  "android_release": { "type": ["string", "null"] },
                  "device_model": { "type": ["string", "null"] },
                  "locale": { "type": ["string", "null"] },
                  "login_state": { "type": ["string", "null"] },
                  "region": { "type": ["string", "null"] },
                  "result": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "path": { "type": ["string", "null"] },
              "observed_at": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
